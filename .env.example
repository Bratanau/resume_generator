# Required for Yandex Foundation Models API-key authentication.
YANDEX_API_KEY=
# Optional key ID; API-key authentication does not require it.
YANDEX_KEY_ID=
# Folder containing the YandexGPT model.
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
YANDEX_MODEL_VERSION=latest
# Optional; defaults to the Yandex Foundation Models completion endpoint.
# YANDEX_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# Local SQLite database file for hiring vacancies and applications.
DATABASE_PATH=data/cvision.sqlite
